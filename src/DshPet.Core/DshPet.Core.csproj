<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure logic: parsing, credentials, configuration. No UI, no WinForms - so it
    can be unit tested without a message pump.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshPet.Core</AssemblyName>
    <RootNamespace>DshPet.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DshPet.Core.Tests" />
  </ItemGroup>

</Project>
